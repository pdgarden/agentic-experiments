# Copy to backend/.env (gitignored).
GATEWAY_URL=http://localhost:4000
GATEWAY_API_KEY=
# Langfuse: tracing is on only when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# ENV=test plus MODEL_OVERRIDE=e2e swaps every model for a scripted FunctionModel (e2e only).
# Web search (Tavily). Without a key the agent has no web_search tool; web_fetch needs no key.
TAVILY_API_KEY=
# MCP servers: backend/mcp.json (gitignored, see mcp.example.json). ${VAR} in env/headers is read from here.
