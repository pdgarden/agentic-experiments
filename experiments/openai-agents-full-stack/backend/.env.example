# Copy to backend/.env (gitignored).

# Any OpenAI-compatible chat completions endpoint.
MODEL_ID=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional: Langfuse tracing is enabled only when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# Optional overrides (defaults shown).
# DB_PATH=data/app.db
# MAX_TURNS=10
# RUN_TIMEOUT_S=300
# MCP_CONFIG_PATH=mcp.json
# MCP_TIMEOUT_S=30
